  <property name="styleSheet">
   <string>QWidget { color: #EAF4FF; font-family: &quot;Microsoft YaHei&quot;; font-size: 14px; }
QWidget#centralwidget { background-color: #061321; }
QWidget#widgetTopBar, QFrame#frameSidebar { background-color: #091D30; border-radius: 8px; }
QFrame#cardDriving, QFrame#cardVehicle, QFrame#cardEnergy, QFrame#cardClimate, QFrame#cardNavigation, QFrame#cardCamera, QFrame#cardMusic, QFrame#cardTrip, QFrame#cardMaintenance { background-color: #102840; border: 1px solid #193C58; border-radius: 10px; }
QLabel { background: transparent; border: none; }
QLabel#labelSpeed { font-size: 64px; font-weight: bold; color: #FFFFFF; }
QLabel#labelTemperature { font-size: 28px; font-weight: bold; }
QLabel#labelRange { font-size: 20px; font-weight: bold; }
QLabel#labelDriveMode { color: #18D8A0; }
QPushButton { background-color: #14344F; border: 1px solid #285577; border-radius: 8px; padding: 6px; min-height: 28px; }
QPushButton:hover { background-color: #1B4769; }
QPushButton:pressed { background-color: #096BA3; }
QPushButton:checked { background-color: #087DB9; border-color: #24C8FF; color: #FFFFFF; }
QPushButton:disabled { background-color: #0C2235; border-color: #1A354B; color: #547086; }
QFrame#frameSidebar QPushButton { border: none; text-align: center; font-size: 16px; min-height: 64px; }
QProgressBar { background-color: #071B2C; border: 1px solid #285577; border-radius: 5px; text-align: center; min-height: 20px; }
QProgressBar::chunk { background-color: #12CDA0; border-radius: 4px; }
QSlider::groove:horizontal { height: 6px; background-color: #071B2C; border-radius: 3px; }
QSlider::sub-page:horizontal { background-color: #16B9EF; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; margin: -5px 0; background-color: #EAF4FF; border-radius: 8px; }</string>
