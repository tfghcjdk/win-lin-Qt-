; Copy to /etc/nev-smarthmi/camera_calibration.ini after calibrating the exact
; /dev/video9 camera at its final mounting position. Do not enable placeholders.
[calibration]
enabled=false
image_width=1280
image_height=720

[camera]
fx=0
fy=0
cx=0
cy=0
k1=0
k2=0
p1=0
p2=0
k3=0

[mounting]
height_cm=0
pitch_degrees=0

[detection]
roi_top_ratio=0.42
min_contour_area=900
analysis_width=640
process_every_frames=3
