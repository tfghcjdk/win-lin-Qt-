; 高德导航配置文件（板端模板 / 仓库模板）
;
; 部署：
;   1. 在高德开放平台控制台创建应用并申请 Key（Web 服务类型，无需 IP 白名单）
;   2. 将本文件复制为 /Kd1234/config/navigation.ini（不要提交到仓库）
;   3. 填写真实 web_service_key
;   4. chmod 600 /Kd1234/config/navigation.ini
;
; 所有路径分隔符使用正斜杠；QSettings IniFormat 兼容 ';' 开头注释。

[amap]
; 高德 Web 服务 Key（必须）—— 不要 echo 到日志或截图
web_service_key=在此粘贴你的高德Web服务Key

; 定位方式：
;   fixed       - 固定坐标模式，origin/destination 都写在本文件
;   phone       - 手机 App 通过 UDP 推送实时位置作为起点（见 [phone_location]）
;   manual      - UI 输入起点和终点坐标（预留）
;   keyword     - 输入地点名称（预留，需中文输入法）
location_mode=fixed

; 经度,纬度（GCJ-02 火星坐标，高德官方坐标系）
; fixed 模式：origin 与 destination 都生效
; phone 模式：origin 忽略（来自手机实时定位），destination 为导航终点，
;             也可以在 UI 导航页"设置目的地"里修改（会回写本文件）
origin=116.481028,39.989643
destination=116.434446,39.908160

; 驾车偏好：0 推荐 / 1 不走高速 / 2 不走收费 / 3 两者都避 / 4 高速优先 / 5 普通路优先
strategy=0

; v5 接口必填：哪些扩展字段要随响应返回（v3 接口请置空）
; cost - 包含费用、时长；tmcs - 分段路况；navi - 详细导航指令；roads - 道路名
show_fields=cost,tmcs,navi,roads

; 是否使用 HTTPS：1 启用；0 退回到 HTTP（仅调试用，生产环境务必启用）
use_https=1

; 单次请求超时（毫秒）
request_timeout_ms=8000

; 路线缓存时间（秒）：同一对起终点在此窗口内不重复请求 API
cache_ttl_seconds=600

[phone_location]
; 手机定位推送（location_mode=phone 时生效）
; Android App 每秒向本端口发送一个 JSON 数据报（WGS-84 坐标）：
;   {"version":1,"seq":42,"time":1757822400000,"lat":39.98,"lng":116.47,
;    "accuracy":12.5,"speed":3.2,"bearing":91.0}
; 同一端口也接收目的地报文（GCJ-02 坐标，不要纠偏；name 可为空）：
;   {"version":1,"type":"destination","name":"望京SOHO","lat":39.9958,"lng":116.4809}
port=45454
; 定位精度阈值（米）：精度差于此值的包直接丢弃
max_accuracy_m=50
; 超过此毫秒数没收到有效包视为定位丢失，UI 显示"等待手机定位"
stale_ms=5000

[route]
; 动态导航参数（location_mode=phone 时生效）
; 偏离路线超过此距离（米）开始计数
deviation_threshold_m=60
; 连续偏离满此次数才触发重规划（防抖）
deviation_samples=5
; 两次算路请求的最小间隔（秒），保护 API 配额
reroute_cooldown_s=30
; 距终点小于此距离（米）判定为到达
arrival_radius_m=30