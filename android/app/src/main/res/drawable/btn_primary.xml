<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#189E8C" android:endColor="#0D7FAE" android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/nev_accent" android:endColor="@color/nev_accent_deep" android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
